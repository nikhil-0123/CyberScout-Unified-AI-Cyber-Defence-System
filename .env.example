# ============================================================================
# CYBERSCOUT CONFIGURATION MANIFEST
# ============================================================================

# Deployment Environment ('development' or 'production')
# In 'production', startup will strictly fail if JWT_SECRET is weak/missing,
# if wildcard CORS is configured, or if MongoDB is unreachable.
ENVIRONMENT=development

# MongoDB Connection String (Required for persistent auth & threat telemetry)
# For local dev: mongodb://localhost:27017/
# For production: mongodb+srv://<user>:<password>@cluster0.mongodb.net/cyberscout?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/

# Feature Flags
ENABLE_EMAIL_ANALYSIS=true
VITE_ENABLE_EMAIL_ANALYSIS=true

# API Server Configuration
PORT=8000
HOST=0.0.0.0
VITE_API_URL=http://localhost:8000

# Security & Authentication (Argon2id + RFC 7519 JWT)
# Production REQUIREMENT: Must be a unique, cryptographically random key of at least 32 characters.
# Generate on Linux/macOS: openssl rand -hex 32
# Generate on Windows PowerShell: [Convert]::ToHexString((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
JWT_SECRET=replace_with_a_cryptographically_secure_random_32_plus_character_secret_e_g_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie Security (Cross-Domain Cloudflare Pages <-> Render API)
# Set to 'true' in production with HTTPS to enable SameSite=None + Secure=True
SECURE_COOKIES=false

# Allowed CORS Origins (Comma-separated exact origins; wildcards '*' are rejected)
# Include your Cloudflare Pages production domain (e.g., https://cyberscout.pages.dev)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000,https://cyberscout.pages.dev
