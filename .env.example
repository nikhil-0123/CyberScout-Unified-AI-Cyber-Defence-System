# MongoDB Connection String
# Use your local MongoDB URI or MongoDB Atlas Cloud URI
MONGO_URI=mongodb://localhost:27017/

# Features
ENABLE_EMAIL_ANALYSIS=true
VITE_ENABLE_EMAIL_ANALYSIS=true

# API Server Configuration
PORT=8000
HOST=0.0.0.0
VITE_API_URL=http://localhost:8000

# Security & Authentication (Phase 2)
# Generate a secure 32+ character key for production (e.g., openssl rand -hex 32)
JWT_SECRET=cyberscout_production_super_secure_jwt_secret_key_minimum_32_bytes_2026
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
